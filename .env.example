# Manager connection: npm run dev:aws and production builds; npm run dev uses local mocks.
# Public manager configuration embedded in dist/config.js. Never add AWS credentials.
MONTHLY_API_URL=https://your-api.execute-api.us-east-1.amazonaws.com
MONTHLY_BUCKET=your-site-bucket

# Only used by npm run dev:feed. Include the media prefix, not a month or filename.
MONTHLY_FEED_URL=https://your-distribution.cloudfront.net/wp-content/uploads/

# Optional local mock login overrides (never sent to the browser).
# Defaults: demo / monthly-local-demo. These are not real AWS/API credentials.
# MONTHLY_DEV_USERNAME=demo
# MONTHLY_DEV_PASSWORD=monthly-local-demo
