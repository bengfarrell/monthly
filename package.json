{
  "name": "@bengfarrell/monthly",
  "version": "0.1.0",
  "description": "Framework-independent monthly media management with lightweight Lit views.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "types": "./dist/modules/index.d.ts",
  "exports": {
    ".": { "types": "./dist/modules/index.d.ts", "import": "./dist/modules/index.js" },
    "./core": { "types": "./dist/modules/core/index.d.ts", "import": "./dist/modules/core/index.js" },
    "./components": { "types": "./dist/modules/components/index.d.ts", "import": "./dist/modules/components/index.js" },
    "./styles.css": "./dist/monthly.css",
    "./dist/monthly.js": "./dist/monthly.js"
  },
  "files": ["src", "dist/modules", "dist/monthly.js", "dist/monthly.css", "lambda", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.build.json && tsx scripts/build.ts",
    "build:lambda": "npm run typecheck && tsx scripts/build-lambda.ts",
    "dev": "vite",
    "dev:aws": "vite --mode aws",
    "dev:feed": "vite --mode feed",
    "fixtures:generate": "tsx scripts/generate-dev-assets.ts",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && tsx --test tests/browser.integration.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@uppy/aws-s3": "^6.3.1",
    "@uppy/core": "^6.3.1",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^8.3.8",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "playwright": "^1.56.1"
  }
}
